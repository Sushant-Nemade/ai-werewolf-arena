# Copy to .env and adjust. Never commit real secrets.

# mock (offline, deterministic) | ollama (local model) | openai (any OpenAI-compatible endpoint)
ARENA_LLM_PROVIDER=mock

# Ollama
ARENA_OLLAMA_BASE_URL=http://localhost:11434
ARENA_OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible (required only when ARENA_LLM_PROVIDER=openai)
ARENA_OPENAI_BASE_URL=https://api.openai.com/v1
ARENA_OPENAI_API_KEY=
ARENA_OPENAI_MODEL=gpt-4o-mini

# Guardrails / memory / rules
ARENA_GUARDRAIL_MAX_RETRIES=2
ARENA_MEMORY_TOP_K=5
ARENA_MAX_ROUNDS=20
ARENA_HUMAN_ACTION_TIMEOUT_SECONDS=600
